{
  "name": "expo-demo",
  "main": "expo-router/entry",
  "version": "0.0.1",
  "scripts": {
    "lint": "yarn run -T concurrently \"yarn biome:check\" \"yarn tsc:check\"",
    "lint:fix": "yarn run -T biome check --write .",
    "biome:check": "yarn run -T biome check .",
    "tsc:check": "yarn run -T tsc --project ./tsconfig.json",
    "start": "EXPO_PUBLIC_STAGE=development expo start --dev-client",
    "expo:prebuild": "expo prebuild --skip-dependency-update react,react-native,expo",
    "ios": "EXPO_PUBLIC_STAGE=development expo run:ios",
    "android": "EXPO_PUBLIC_STAGE=development expo run:android",
    "ios:development": "yarn clean:native && EXPO_PUBLIC_STAGE=development yarn expo:prebuild && EXPO_PUBLIC_STAGE=development yarn ios",
    "android:development": "yarn clean:native && EXPO_PUBLIC_STAGE=development yarn expo:prebuild && EXPO_PUBLIC_STAGE=development yarn android",
    "ios:preview": "yarn clean:native && EXPO_PUBLIC_STAGE=preview yarn expo:prebuild && EXPO_PUBLIC_STAGE=preview expo run:ios",
    "android:preview": "yarn clean:native && EXPO_PUBLIC_STAGE=preview yarn expo:prebuild && EXPO_PUBLIC_STAGE=preview expo run:android",
    "build:development": "EXPO_PUBLIC_STAGE=development eas build --profile development --platform all",
    "build:development:ios": "EXPO_PUBLIC_STAGE=development eas build --profile development --platform ios",
    "build:development:android": "EXPO_PUBLIC_STAGE=development eas build --profile development --platform android",
    "build:preview": "EXPO_PUBLIC_STAGE=preview eas build --profile preview --platform all",
    "build:preview:ios": "EXPO_PUBLIC_STAGE=preview eas build --profile preview --platform ios",
    "build:preview:android": "EXPO_PUBLIC_STAGE=preview eas build --profile preview --platform android",
    "clean:native": "rm -rf android && rm -rf ios && rm -rf .expo"
  },
  "dependencies": {
    "@expo/ui": "~57.0.18",
    "@hzblj/kara-ui": "^0.14.0",
    "@lodev09/react-native-true-sheet": "3.11.18",
    "@react-native-community/netinfo": "12.0.1",
    "auto-zustand-selectors-hook": "^3.0.1",
    "expo": "~57.0.31",
    "expo-application": "~57.0.2",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "i18next": "^26.4.2",
    "immer": "^11.1.18",
    "intl-pluralrules": "^2.0.1",
    "node-libs-react-native": "^1.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.13",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-fetch": "^1.9.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native/metro-config": "0.86.3",
    "@types/react": "~19.2.18",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "typescript": "~7.0.2"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": "../../packages"
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-randombytes"
        ],
        "listUnknownPackages": false
      }
    },
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
