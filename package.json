{
  "name": "@janblazej/react-native-expo-monorepo",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/expo-demo",
    "packages/*"
  ],
  "keywords": [
    "react-native",
    "expo",
    "expo-router",
    "kara-ui",
    "monorepo",
    "typescript",
    "turbo",
    "yarn-workspaces",
    "mobile-development",
    "biome",
    "cross-platform",
    "react",
    "swift",
    "kotlin",
    "expo-modules"
  ],
  "scripts": {
    "app": "yarn workspace expo-demo",
    "start": "yarn app start",
    "ios": "yarn app ios",
    "android": "yarn app android",
    "ios:dev": "yarn app ios:development",
    "android:dev": "yarn app android:development",
    "ios:preview": "yarn app ios:preview",
    "android:preview": "yarn app android:preview",
    "prebuild": "yarn app expo:prebuild",
    "doctor": "cd apps/expo-demo && yarn dlx expo-doctor",
    "lint": "yarn turbo run lint",
    "lint:fix": "yarn turbo run lint:fix",
    "typecheck": "yarn turbo run tsc:check",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "format": "biome format --write .",
    "clean": "yarn clean:turbo && yarn app clean:native",
    "clean:turbo": "rm -rf ./node_modules/.cache/turbo && rm -rf ./.turbo && find . -name '.turbo' -type d -prune -exec rm -rf '{}' +",
    "clean:native": "yarn app clean:native",
    "clean:node-modules": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@biomejs/biome": "~2.5.15",
    "@hzblj/biome-config": "^0.2.1",
    "@types/node": "^26.5.1",
    "concurrently": "^10.0.5",
    "path": "0.12.7",
    "react-native-os": "1.2.6",
    "turbo": "^2.10.12",
    "typescript": "~7.0.2"
  },
  "packageManager": "yarn@4.17.1"
}
